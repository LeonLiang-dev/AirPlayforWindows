[Version]
Signature   = "$Windows NT$"
Class       = MEDIA
Provider    = %ProviderName%
ClassGUID   = {4d36e96c-e325-11ce-bfc1-08002be10318}
DriverVer   = 08/09/2026, 0.1.0.0
CatalogFile = AirPlayFlowVad.cat
PnpLockDown = 1

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
AirPlayFlowVad.sys = 1

[Manufacturer]
%MfgName% = AirPlayFlow,NT$ARCH$.10.0...22621

[AirPlayFlow.NT$ARCH$.10.0...22621]
%DeviceDesc% = AirPlayFlowVad, Root\AirPlayFlowVad

[DestinationDirs]
AirPlayFlowVad.CopyList = 13

[AirPlayFlowVad.CopyList]
AirPlayFlowVad.sys

[AirPlayFlowVad.AddReg]
HKR,,AssociatedFilters,,"wdmaud,swmidi,redbook"
HKR,,Driver,,AirPlayFlowVad.sys
HKR,Drivers,SubClasses,,"wave,midi,mixer"
HKR,Drivers\wave\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\midi\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\mixer\wdmaud.drv,Driver,,wdmaud.drv
HKR,Drivers\wave\wdmaud.drv,Description,,%DeviceDesc%
HKR,Drivers\midi\wdmaud.drv,Description,,%MidiDesc%
HKR,Drivers\mixer\wdmaud.drv,Description,,%DeviceDesc%

[AirPlayFlowVad.I.Wave]
AddReg = AirPlayFlowVad.I.Wave.AddReg

[AirPlayFlowVad.I.Wave.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%WaveFriendlyName%

[AirPlayFlowVad.I.Topology]
AddReg = AirPlayFlowVad.I.Topology.AddReg

[AirPlayFlowVad.I.Topology.AddReg]
HKR,,CLSID,,%Proxy.CLSID%
HKR,,FriendlyName,,%TopologyFriendlyName%
HKR,EP\0,%PKEY_AudioEndpoint_Association%,,%KSNODETYPE_ANY%
HKR,EP\0,%PKEY_AudioEndpoint_Supports_EventDriven_Mode%,0x00010001,0x1

[AirPlayFlowVad.NT]
Include = ks.inf,wdmaudio.inf
Needs = KS.Registration,WDMAUDIO.Registration
CopyFiles = AirPlayFlowVad.CopyList
AddReg = AirPlayFlowVad.AddReg

[AirPlayFlowVad.NT.Interfaces]
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_WaveSpeaker%,AirPlayFlowVad.I.Wave
AddInterface = %KSCATEGORY_RENDER%,%KSNAME_WaveSpeaker%,AirPlayFlowVad.I.Wave
AddInterface = %KSCATEGORY_REALTIME%,%KSNAME_WaveSpeaker%,AirPlayFlowVad.I.Wave
AddInterface = %KSCATEGORY_AUDIO%,%KSNAME_TopologySpeaker%,AirPlayFlowVad.I.Topology
AddInterface = %KSCATEGORY_TOPOLOGY%,%KSNAME_TopologySpeaker%,AirPlayFlowVad.I.Topology

[AirPlayFlowVad.NT.Services]
AddService = AirPlayFlowVad,0x00000002,AirPlayFlowVad.Service

[AirPlayFlowVad.Service]
DisplayName = %ServiceDesc%
ServiceType = 1
StartType = 3
ErrorControl = 1
ServiceBinary = %13%\AirPlayFlowVad.sys

[AirPlayFlowVad.NT.HW]
AddReg = AirPlayFlowVad.HW.AddReg

[AirPlayFlowVad.HW.AddReg]
HKR,,DeviceType,0x10001,0x0000001D
HKR,,Security,,"D:P(A;;GA;;;SY)(A;;GRGWGX;;;BA)(A;;GRGWGX;;;WD)(A;;GRGWGX;;;RC)"

[AirPlayFlowVad.NT.Wdf]
KmdfService = AirPlayFlowVad,AirPlayFlowVad.Wdf

[AirPlayFlowVad.Wdf]
KmdfLibraryVersion = $KMDFVERSION$

[Strings]
ProviderName = "AirPlay Flow Win"
MfgName = "AirPlay Flow Win"
DiskName = "AirPlay Flow Win Virtual Audio Driver"
DeviceDesc = "AirPlay Flow Win Virtual Audio"
ServiceDesc = "AirPlay Flow Win Virtual Audio Driver"
MidiDesc = "AirPlay Flow Win MIDI"
WaveFriendlyName = "AirPlay Flow Win"
TopologyFriendlyName = "AirPlay Flow Win Topology"

KSNAME_WaveSpeaker = "WaveSpeaker"
KSNAME_TopologySpeaker = "TopologySpeaker"
Proxy.CLSID = "{17CCA71B-ECD7-11D0-B908-00A0C9223196}"
KSCATEGORY_AUDIO = "{6994AD04-93EF-11D0-A3CC-00A0C9223196}"
KSCATEGORY_RENDER = "{65E8773E-8F56-11D0-A3B9-00A0C9223196}"
KSCATEGORY_REALTIME = "{EB115FFC-10C8-4964-831D-6DCB02E6F23F}"
KSCATEGORY_TOPOLOGY = "{DDA54A40-1E4C-11D1-A050-405705C10000}"
KSNODETYPE_ANY = "{00000000-0000-0000-0000-000000000000}"
PKEY_AudioEndpoint_Association = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},2"
PKEY_AudioEndpoint_Supports_EventDriven_Mode = "{1DA5D803-D492-4EDD-8C23-E0C0FFEE7F0E},7"
